# Phase 7B Level 1 topology: multi-VM, SINGLE PHYSICAL HOST (a Mac running
# Multipass). This is NOT infrastructure independence; see reports/INDEPENDENCE.md.
#
# COORD_VM   runs kind + nginx + 3 coordinator replicas (docker compose)
# ADMIN_IP   the only address allowed to SSH to signer hosts (the operator Mac)
# SIGNERS    id:vm:port; each id exactly once. A VM listed twice holds exactly
#            those two signers and nothing else.
COORD_VM=tk8s
ADMIN_IP=192.168.252.1
SIGNERS="1:sig-a:8441 2:sig-a:8442 3:sig-b:8443 4:sig-b:8444 5:sig-c:8445"
