# Threshold coordinator (ExternalJWTSigner v1). Holds no share and no private
# key: public-meta.json, the policy file, the CA cert and its own client cert
# are mounted at runtime (I3). Nothing secret is copied into any layer.
FROM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/grpc-proxy ./cmd/grpc-proxy

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN adduser -D -H -u 10001 coordinator
COPY --from=builder /out/grpc-proxy /usr/local/bin/grpc-proxy
USER 10001
ENTRYPOINT ["/usr/local/bin/grpc-proxy"]
