FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go mod tidy && go build -o /bin/signer ./cmd/signer/

FROM alpine:3.20

COPY --from=builder /bin/signer /bin/signer
COPY --from=builder /app/data/frost-keys.json /app/data/frost-keys.json

WORKDIR /app

ENTRYPOINT ["/bin/signer"]
