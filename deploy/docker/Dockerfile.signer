# Threshold signer. Its one share, public-meta.json, the policy file and its
# own TLS cert are mounted at runtime (I4). Nothing secret is copied into any
# layer, so one image serves every signer.
FROM golang:1.27.1-alpine3.24 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/signer ./cmd/signer

FROM alpine:3.24
RUN adduser -D -H -u 10001 signer && mkdir -p /var/log/frost && chown 10001 /var/log/frost
COPY --from=builder /out/signer /usr/local/bin/signer
USER 10001
ENTRYPOINT ["/usr/local/bin/signer"]
