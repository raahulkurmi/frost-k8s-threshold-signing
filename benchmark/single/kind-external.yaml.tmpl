# Phase 7A/7B benchmark cluster for B1 and T: test/e2e/kind-config.yaml.tmpl
# plus apiserver audit of TokenRequest only (benchmark/single/apiserver-audit-policy/). Rendered by
# benchmark/single/run.sh (__REPO__ -> repo path).
#
# kube-apiserver signs service account tokens ONLY through the external
# signer: --service-account-signing-endpoint is added, and kubeadm's
# --service-account-signing-key-file / --service-account-key-file (mutually
# exclusive with the endpoint) are removed by guarded JSON patches, as is the
# controller-manager's --service-account-private-key-file (legacy token
# controller). Each patch `test`s the exact flag before removing it, so a
# kubeadm layout change fails cluster creation instead of misconfiguring it.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: tk8s
nodes:
- role: control-plane
  image: kindest/node:v1.36.5-tk8s
  extraMounts:
  - hostPath: __REPO__/run
    containerPath: /var/run/frost-k8s
  - hostPath: __REPO__/test/e2e/kubeadm-patches
    containerPath: /etc/frost-kubeadm-patches
    readOnly: true
  - hostPath: __REPO__/benchmark/single/apiserver-audit-policy
    containerPath: /etc/kubernetes/audit
    readOnly: true
- role: worker
  image: kindest/node:v1.36.5-tk8s
kubeadmConfigPatches:
- |
  kind: ClusterConfiguration
  apiServer:
    extraArgs:
      service-account-signing-endpoint: /var/run/frost-k8s/signer.sock
      service-account-issuer: https://kubernetes.default.svc.cluster.local
      audit-policy-file: /etc/kubernetes/audit/audit-policy.yaml
      audit-log-path: /var/log/kubernetes/audit.log
      audit-log-maxsize: "500"
    extraVolumes:
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: Directory
    - name: audit-log
      hostPath: /var/log/kubernetes
      mountPath: /var/log/kubernetes
      pathType: DirectoryOrCreate
    - name: frost-socket
      hostPath: /var/run/frost-k8s
      mountPath: /var/run/frost-k8s
      pathType: Directory
- |
  kind: InitConfiguration
  patches:
    directory: /etc/frost-kubeadm-patches
